# Server Configuration
PORT=3001
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage Configuration
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_FILE_SIZE=5368709120
# Cap on the cumulative uncompressed size of an archive (zip-bomb guard)
MAX_EXTRACTED_SIZE=10737418240
# RAR archives are fully buffered in memory during extraction, so they get
# a stricter limit than the general upload size
MAX_RAR_SIZE=1073741824
FILE_CLEANUP_INTERVAL=3600000

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=1800000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# WebSocket Configuration
WS_CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
